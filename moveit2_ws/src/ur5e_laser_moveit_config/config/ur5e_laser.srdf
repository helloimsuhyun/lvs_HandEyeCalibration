<?xml version="1.0"?>
<robot name="ur5e_laser">
  <!-- Planning is done on the sensor physical origin, not tool0/flange. -->
  <group name="ur5e_arm">
    <chain base_link="base_link" tip_link="sensor_physical_origin"/>
  </group>

  <group_state name="home" group="ur5e_arm">
    <joint name="shoulder_pan_joint" value="0"/>
    <joint name="shoulder_lift_joint" value="-1.570796327"/>
    <joint name="elbow_joint" value="1.570796327"/>
    <joint name="wrist_1_joint" value="-1.570796327"/>
    <joint name="wrist_2_joint" value="-1.570796327"/>
    <joint name="wrist_3_joint" value="0"/>
  </group_state>

  <!-- Universal Robots' standard self-collision exemptions (Humble). -->
  <disable_collisions link1="base_link" link2="base_link_inertia" reason="Adjacent"/>
  <disable_collisions link1="base_link_inertia" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="tool0" link2="wrist_1_link" reason="Never"/>
  <disable_collisions link1="tool0" link2="wrist_2_link" reason="Never"/>
  <disable_collisions link1="tool0" link2="wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_3_link" reason="Never"/>
  <disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent"/>

  <!-- Fixed flange / sensor assembly. Do not disable sensor vs wrist_2 or
       earlier moving links; those must remain collision checked. -->
  <disable_collisions link1="wrist_3_link" link2="flange" reason="Adjacent"/>
  <disable_collisions link1="flange" link2="tool0" reason="Adjacent"/>
  <disable_collisions link1="flange" link2="sensor_measurement_frame" reason="Adjacent"/>
  <disable_collisions link1="wrist_3_link" link2="sensor_measurement_frame" reason="Adjacent"/>
  <disable_collisions link1="sensor_measurement_frame" link2="sensor_physical_origin" reason="Adjacent"/>
</robot>
